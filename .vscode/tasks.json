{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GorillasEX: Compile Windows",
            "type": "process",
            "command": "C:\\DESENV\\BasicProgramming\\qb64pe\\qb64pe.exe",
            "args": [
                "-x",
                "gorillas.bas",
                "-o",
                "${workspaceFolder}\\bin\\GorillasEX.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\src"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Post-Build Windows",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\pos-build-windows.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Build",
            "dependsOn": [
                "GorillasEX: Compile Windows",
                "GorillasEX: Post-Build Windows"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Run",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\GorillasEX.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "GorillasEX: Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Syntax Check",
            "type": "process",
            "command": "C:\\DESENV\\BasicProgramming\\qb64pe\\qb64pe.exe",
            "args": [
                "-z",
                "gorillas.bas"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\src"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Package Source ZIP",
            "type": "process",
            "command": "${workspaceFolder}\\Package-GorillasEX.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Package Binary ZIP",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\Package-GorillasEX-bin.bat",
            "options": {
                "cwd": "${workspaceFolder}\\bin"
            },
            "dependsOn": [
                "GorillasEX: Build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Build Linux RHEL8",
            "type": "process",
            "command": "${workspaceFolder}\\Build-Linux-RHEL8.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Build Linux Ubuntu",
            "type": "process",
            "command": "${workspaceFolder}\\Build-Linux-Ubuntu.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Post-Build Linux",
            "type": "process",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "--platform",
                "linux/amd64",
                "--mount",
                "type=bind,source=${workspaceFolder},target=/project",
                "--entrypoint",
                "/bin/bash",
                "gorillasex-builder:rhel8-qb64pe-4.6.0",
                "-c",
                "set -e; objcopy --add-section .credits=/project/docs/CREDITS.txt --set-section-flags .credits=contents,readonly /project/bin/GorillasEX-linux-x86_64 /project/bin/GorillasEX-linux-x86_64-credits"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "GorillasEX: Build Linux Complete",
            "dependsOn": [
                "GorillasEX: Build Linux RHEL8",
                "GorillasEX: Post-Build Linux"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}