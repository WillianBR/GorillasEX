# GorillasEX - Git ignore rules

# Generated executables
*.exe

# Debug and temporary files
*.dbg
*.dmp

# Compiler temporary files
*.o
*.obj
*.a

# Build directories
/build/
/dist/
*.zip

# Runtime data
*.log

# Local editor settings
.vs/

# Keep VSCode project configuration
!.vscode/

#
# Custom rules can be added below this line
#
desktop.ini
bin/
